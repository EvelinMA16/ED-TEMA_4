<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/22"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.evelinsystem.arbol.controller.GrafoNoPonderadoController">

    <VBox spacing="12"
          AnchorPane.bottomAnchor="20"
          AnchorPane.leftAnchor="25"
          AnchorPane.rightAnchor="25"
          AnchorPane.topAnchor="20">

        <Label text="GRAFO NO PONDERADO"
               style="-fx-font-size: 26px; -fx-font-weight: bold;"
               alignment="CENTER"
               maxWidth="Infinity"/>

        <Label text="Grafo donde las conexiones no tienen pesos ni valores numéricos."
               style="-fx-font-size: 13px; -fx-text-fill: #777777;"
               alignment="CENTER"
               maxWidth="Infinity"/>

        <HBox spacing="20">

            <VBox spacing="10" prefWidth="220">

                <Label text="AGREGAR VÉRTICE"
                       style="-fx-font-weight: bold;"/>

                <TextField fx:id="txtVertice"
                           promptText="Nombre del vértice"/>

                <Button text="Agregar vértice"
                        onAction="#agregarVertice"
                        maxWidth="Infinity"/>

                <Label text="AGREGAR CONEXIÓN"
                       style="-fx-font-weight: bold;"/>

                <TextField fx:id="txtOrigen"
                           promptText="Vértice de origen"/>

                <TextField fx:id="txtDestino"
                           promptText="Vértice de destino"/>

                <Button text="Agregar conexión"
                        onAction="#agregarConexion"
                        maxWidth="Infinity"/>

                <Label text="RECORRIDOS"
                       style="-fx-font-weight: bold;"
                       alignment="CENTER"
                       maxWidth="Infinity"/>

                <TextField fx:id="txtInicio"
                           promptText="Vértice inicial"/>

                <Button text="Recorrido BFS (Anchura)"
                        onAction="#mostrarRecorridoBFS"
                        maxWidth="Infinity"/>

                <Button text="Recorrido DFS (Profundidad)"
                        onAction="#mostrarRecorridoDFS"
                        maxWidth="Infinity"/>

                <HBox spacing="10">
                    <Button text="Limpiar"
                            onAction="#vaciar"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"/>

                    <Button text="Regresar"
                            onAction="#Onregresar"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"/>
                </HBox>

            </VBox>

            <VBox spacing="10" HBox.hgrow="ALWAYS">

                <Label text="REPRESENTACIÓN DEL GRAFO"
                       style="-fx-font-weight: bold;"
                       alignment="CENTER"
                       maxWidth="Infinity"/>

                <Pane fx:id="paneGrafo"
                      prefHeight="400"
                      prefWidth="700"
                      style="-fx-background-color: #F5F1E8;
                             -fx-border-color: #B7A58A;"/>

                <Label text="RESULTADOS"
                       style="-fx-font-weight: bold;"
                       alignment="CENTER"
                       maxWidth="Infinity"/>

                <TextArea fx:id="txtResultado"
                          editable="false"
                          prefHeight="100"
                          wrapText="true"
                          promptText="Aquí aparecerá la información del grafo."/>

            </VBox>

        </HBox>

        <Button text="Mostrar vértices y conexiones"
                onAction="#mostrarVertices"
                maxWidth="220"/>

    </VBox>

</AnchorPane>